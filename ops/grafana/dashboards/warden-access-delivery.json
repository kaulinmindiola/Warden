    {"type": "timeseries", "id": 10, "title": "Deliveries by status and scope", "description": "warden_notification_deliveries; counted once for the whole database, so instances are not added up", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (status, scope) (warden_notification_deliveries)", "legendFormat": "{{scope}} {{status}}", "range": true}]},
    {"type": "stat", "id": 11, "title": "Dead-letter queue", "description": "Deliveries in DEAD by scope; the system scope is only visible here (DEC-004)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 4, "x": 8, "y": 18}, "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "auto", "orientation": "auto"}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (scope) (warden_notification_deliveries{status=\"dead\"})", "legendFormat": "{{scope}}", "instant": true}]},
    {"type": "stat", "id": 12, "title": "Circuit breakers open", "description": "1 when the breaker of a provider is open", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 4, "x": 12, "y": 18}, "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "auto", "orientation": "auto"}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (provider) (warden_provider_circuit_state{state=\"open\"})", "legendFormat": "{{provider}}", "instant": true}]},
    {"type": "timeseries", "id": 13, "title": "Provider attempts by result", "description": "warden_notification_attempts_total, per second", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (provider, result) (rate(warden_notification_attempts_total[$__rate_interval]))", "legendFormat": "{{provider}} {{result}}", "range": true}]},
    {"type": "timeseries", "id": 14, "title": "Provider error rate", "description": "Share of transient failures among the calls to each provider", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 26}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (provider) (rate(warden_notification_attempts_total{result=\"transient_failure\"}[$__rate_interval])) / sum by (provider) (rate(warden_notification_attempts_total[$__rate_interval]))", "legendFormat": "{{provider}}", "range": true}]},
    {"type": "timeseries", "id": 15, "title": "Provider latency", "description": "Mean duration of the calls to each provider (warden_provider_request_seconds)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 26}, "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (provider) (rate(warden_provider_request_seconds_sum[$__rate_interval])) / sum by (provider) (rate(warden_provider_request_seconds_count[$__rate_interval]))", "legendFormat": "{{provider}}", "range": true}]},
    {"type": "timeseries", "id": 16, "title": "Outbox", "description": "Pending events and p95 of the time from occurrence to publication; target 5 s (REQ-PERF-004)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 26}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(warden_outbox_pending)", "legendFormat": "pending", "range": true}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(warden_outbox_lag_seconds_bucket[$__rate_interval])))", "legendFormat": "lag p95 (s)", "range": true}]}
