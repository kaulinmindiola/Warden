{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/messages",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.to", "matches": ".*@invalid\\.test" } }
    ]
  },
  "response": {
    "status": 422,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "code": "invalid_recipient" }
  }
}