# Copy this file to .env to override the local defaults of compose.yaml. Never commit .env.
#
# Docker Compose reads .env automatically. The application started with
# "spring-boot:run" does not: if you change a password or a port here, set the same
# variable in your shell before starting the application.

# PostgreSQL
# WARDEN_DB_PORT=5432
# WARDEN_DB_SUPERUSER_PASSWORD=change-me
# WARDEN_DB_OWNER_PASSWORD=change-me
# WARDEN_DB_APP_PASSWORD=change-me
# Milliseconds to obtain a connection before the request is denied with 503:
# WARDEN_DB_CONNECTION_TIMEOUT_MS=2000

# Redis
# WARDEN_REDIS_PORT=6379
# Command and connection timeouts; a failing Redis switches revocation checks to PostgreSQL:
# WARDEN_REDIS_TIMEOUT=200ms
# WARDEN_REDIS_CONNECT_TIMEOUT=1s

# Key material (REQ-INST-002). Required outside the local profile; the local profile
# generates ephemeral keys when they are missing. Never commit real values.
# Commands use the openssl bundled with Git for Windows (Git Bash) or any OpenSSL 3.
#
# ES256 (P-256) signing key, PKCS#8 as single-line Base64:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -outform DER | openssl base64 -A
# WARDEN_JWT_SIGNING_KEY=change-me
# WARDEN_JWT_KEY_ID=2026-01
#
# AES-256 keys as id:base64key[,id:base64key]; the first one seals new secrets:
#   openssl rand -base64 32
# WARDEN_SECRET_KEYS=k1:change-me
#
# HMAC-SHA-256 key, at least 32 bytes in Base64:
#   openssl rand -base64 32
# WARDEN_HMAC_KEY=change-me

# TLS (REQ-SEC-019). Required by the prod-like profile, which serves the API over HTTPS only and
# sends HSTS; the local profile uses plain HTTP. A PKCS#12 keystore with the server certificate
# and its private key; for a self-signed one (keytool comes with the JDK):
#   keytool -genkeypair -alias warden -keyalg RSA -keysize 2048 -validity 365 -dname "CN=localhost"
#     -ext "san=dns:localhost,ip:127.0.0.1" -storetype PKCS12 -keystore warden-tls.p12
# WARDEN_TLS_KEYSTORE=file:/path/to/warden-tls.p12
# WARDEN_TLS_KEYSTORE_PASSWORD=change-me
# WARDEN_SERVER_PORT=8443

# Rate limits (ADR-014). The defaults are the SRS values; override them only for local
# experiments. Each limit has a CAPACITY (requests) and a WINDOW (e.g. 30s, 15m, 1h, 1d);
# the policies are LOGINFAILURESPEREMAIL, LOGINPERIP, PASSWORDRESETPEREMAIL,
# PASSWORDRESETPERIP, REFRESHPERIP, VERIFICATIONRESENDPERACCOUNT, INVITATIONSPERWORKSPACE
# and INVITATIONSPERINVITER.
# WARDEN_RATELIMIT_LOGINPERIP_CAPACITY=20
# WARDEN_RATELIMIT_LOGINPERIP_WINDOW=1m
# Timeout of each Redis command of the rate limiter:
# WARDEN_RATELIMIT_REDISCOMMANDTIMEOUT=200ms
# Simulated e-mail providers (REQ-INT-008). Compose publishes WireMock for provider A on 8091 and
# provider B on 8092; PRIMARY chooses which one is tried first (a or b).
# WARDEN_PROVIDER_PRIMARY=a
# WARDEN_PROVIDER_A_URL=http://localhost:8091
# WARDEN_PROVIDER_B_URL=http://localhost:8092
# WARDEN_PROVIDER_A_PORT=8091
# WARDEN_PROVIDER_B_PORT=8092

# Single-use links (REQ-INT-009): pages of the API consumer. The token is appended as a fragment
# (#token=...), so a base URL must be absolute, http or https, without query and without fragment.
# WARDEN_LINK_VERIFY_EMAIL_URL=http://localhost:3001/verify-email
# WARDEN_LINK_RESET_PASSWORD_URL=http://localhost:3001/reset-password
# WARDEN_LINK_ACCEPT_INVITATION_URL=http://localhost:3001/accept-invitation
